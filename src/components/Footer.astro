---
import { SITE, NAV_LINKS } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-ink-900 text-ink-200">
  <div class="mx-auto grid max-w-[1400px] gap-10 px-6 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <p class="text-lg font-semibold text-white">{SITE.name}</p>
      <p class="mt-3 max-w-sm text-sm text-ink-400">{SITE.tagline}</p>
      <div class="mt-5 flex flex-col gap-1 text-sm">
        <a href={SITE.whatsappUrl} class="hover:text-white">{SITE.phoneDisplay}</a>
        <a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a>
      </div>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-ink-400">Navigasi</p>
      <ul class="mt-4 space-y-2 text-sm">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} class="hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-ink-400">Lokasi</p>
      <div class="mt-4 space-y-3 text-sm text-ink-400">
        <p><span class="text-ink-200">Kantor:</span> {SITE.officeAddress}</p>
        <p><span class="text-ink-200">Workshop:</span> {SITE.workshopAddress}</p>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 px-6 py-5 text-center text-xs text-ink-400">
    &copy; {year} {SITE.name}. Semua hak cipta dilindungi.
  </div>
</footer>
