---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { SITE } from "../lib/site";
import { IMAGES } from "../lib/images";

const values = [
  {
    title: "Kualitas Konsisten",
    detail: "Setiap tahap pengerjaan, dari persiapan permukaan hingga finishing, mengikuti standar yang sama di setiap proyek.",
  },
  {
    title: "Tepat Waktu",
    detail: "Perencanaan dan eksekusi proyek yang rapi agar jadwal serah terima terjaga tanpa mengorbankan kualitas.",
  },
  {
    title: "Standar Industri",
    detail: "Mengacu pada standar seperti ISO 21809-1 untuk pipe coating dan praktik terbaik surface finishing.",
  },
  {
    title: "Dipercaya Klien Besar",
    detail: "Telah menangani proyek untuk perusahaan swasta maupun institusi pemerintah.",
  },
];
---

<BaseLayout title="Tentang Kami" description="Kenali Munggaran Proteksi, penyedia jasa surface finishing untuk kebutuhan industri, konstruksi, dan infrastruktur.">
  <section class="bg-ink-900 py-[120px] text-white">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Tentang Kami</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight">{SITE.philosophy}</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">{SITE.description}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1400px] grid-cols-1 gap-12 px-6 py-[120px] md:grid-cols-2 md:items-center">
    <Image src={IMAGES.about} alt="Workshop dan tim Munggaran Proteksi" class="rounded-2xl" width={600} height={450} />
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Cerita Kami</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-900">
        Fokus pada Detail, dari Persiapan hingga Serah Terima
      </h2>
      <p class="mt-5 text-ink-600">
        Munggaran Proteksi berdiri untuk menjawab kebutuhan industri dan konstruksi akan solusi
        permukaan yang tahan lama dan berkualitas. Kami mengerjakan epoxy flooring, sandblasting &amp;
        painting, polished concrete, dan pipe wrapping dengan tim yang berpengalaman menangani proyek
        skala besar maupun menengah.
      </p>
      <p class="mt-4 text-ink-600">
        Setiap proyek kami tangani dengan pendekatan yang sama: survey menyeluruh, persiapan permukaan
        yang tepat, aplikasi sesuai spesifikasi, dan quality check sebelum serah terima — memastikan
        hasil akhir yang rapi dan tahan lama untuk berbagai kebutuhan klien.
      </p>
      <div class="mt-8 grid grid-cols-3 gap-4">
        {SITE.stats.map((stat) => (
          <div>
            <p class="text-2xl font-bold text-brand-600">{stat.value}</p>
            <p class="mt-1 text-xs font-medium text-ink-600">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-ink-50 py-[120px]">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="grid grid-cols-1 gap-10 md:grid-cols-2">
        <div class="rounded-2xl border border-ink-100 bg-white p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Misi</p>
          <ul class="mt-4 space-y-3 text-ink-700">
            {SITE.mission.map((item) => (
              <li class="flex gap-3">
                <span class="mt-0.5 text-brand-600">&check;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl border border-ink-100 bg-white p-8">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Visi</p>
          <p class="mt-4 text-ink-700">{SITE.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Kenapa Munggaran Proteksi</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-bold text-ink-900">Nilai yang Kami Pegang di Setiap Proyek</h2>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((value) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <h3 class="font-semibold text-ink-900">{value.title}</h3>
          <p class="mt-2 text-sm text-ink-600">{value.detail}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-50 py-[120px]">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Tim Kami</p>
      <h2 class="mt-3 max-w-2xl text-3xl font-bold text-ink-900">Orang-Orang di Balik Setiap Proyek</h2>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {SITE.team.map((member) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-6 text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-lg font-semibold text-brand-700">
              {member.name.split(" ").map((n) => n[0]).slice(0, 2).join("")}
            </div>
            <p class="mt-4 font-semibold text-ink-900">{member.name}</p>
            <p class="mt-1 text-sm text-ink-600">{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="rounded-3xl border border-ink-100 bg-white p-10 text-center md:p-14">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Kredensial</p>
      <h2 class="mt-3 text-2xl font-bold text-ink-900">Standar ISO 21809-1 untuk Pipe Coating</h2>
      <p class="mx-auto mt-4 max-w-xl text-ink-600">
        Layanan pipe wrapping kami mengikuti standar internasional ISO 21809-1 untuk memastikan
        kualitas dan keandalan perlindungan korosi pada pipa industri.
      </p>
    </div>
  </section>
</BaseLayout>
