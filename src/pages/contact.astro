---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm";
import { SITE } from "../lib/site";

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<BaseLayout title="Kontak" description="Hubungi Munggaran Proteksi untuk konsultasi epoxy flooring, sandblasting & painting, polished concrete, dan pipe wrapping.">
  <section class="bg-ink-900 py-[120px] text-white">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Kontak</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight">Konsultasikan Kebutuhan Proyek Anda</h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">
        Tim kami siap membantu survey lokasi dan memberikan penawaran sesuai kebutuhan proyek Anda.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
      <div class="lg:col-span-2">
        <div class="rounded-2xl border border-ink-100 p-6">
          <h2 class="text-lg font-semibold text-ink-900">Chat Langsung</h2>
          <p class="mt-2 text-sm text-ink-600">Cara tercepat untuk konsultasi dan penawaran.</p>
          <a
            href={SITE.whatsappUrl}
            class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-white hover:bg-accent-600"
          >
            Chat via WhatsApp — {SITE.phoneDisplay}
          </a>
        </div>

        <div class="mt-6 space-y-6 rounded-2xl border border-ink-100 p-6">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">Email</h3>
            <a href={`mailto:${SITE.email}`} class="mt-1 block text-ink-800 hover:text-brand-600">
              {SITE.email}
            </a>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">Kantor</h3>
            <p class="mt-1 text-ink-800">{SITE.officeAddress}</p>
          </div>
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wide text-ink-400">Workshop</h3>
            <p class="mt-1 text-ink-800">{SITE.workshopAddress}</p>
          </div>
        </div>

        <div class="mt-6 overflow-hidden rounded-2xl border border-ink-100">
          <iframe
            title="Lokasi Kantor Munggaran Proteksi"
            width="100%"
            height="260"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            src={`https://www.google.com/maps?q=${encodeURIComponent(SITE.officeAddress)}&output=embed`}
          ></iframe>
        </div>
      </div>

      <div class="lg:col-span-3">
        <div class="rounded-2xl border border-ink-100 p-6 md:p-8">
          <h2 class="text-lg font-semibold text-ink-900">Kirim Pesan</h2>
          <p class="mt-2 text-sm text-ink-600">Isi form berikut dan tim kami akan menghubungi Anda kembali.</p>
          <div class="mt-6">
            <ContactForm client:load accessKey={web3formsKey} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
