---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { IMAGES } from "../../lib/images";
import { SITE } from "../../lib/site";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Layanan" description="Layanan surface finishing Munggaran Proteksi: epoxy flooring, sandblasting & painting, polished concrete, dan pipe wrapping.">
  <section class="bg-ink-900 py-[120px] text-white">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Layanan Kami</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight">
        Solusi Surface Finishing untuk Setiap Kebutuhan Proyek
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">
        Empat layanan inti yang kami kerjakan dengan standar kualitas industri.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {services.map((service) => (
        <a
          href={`/services/${service.id}`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-ink-100 transition-shadow hover:shadow-lg"
        >
          <Image
            src={IMAGES[service.data.cardImage as keyof typeof IMAGES]}
            alt={service.data.title}
            class="h-56 w-full object-cover"
            width={800}
            height={450}
          />
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-xl font-semibold text-ink-900 group-hover:text-brand-600">
              {service.data.title}
            </h2>
            <p class="mt-3 flex-1 text-ink-600">{service.data.shortDescription}</p>
            <span class="mt-5 text-sm font-semibold text-brand-600">Lihat detail layanan &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 pb-20">
    <div class="flex flex-col items-center rounded-3xl bg-brand-700 px-8 py-14 text-center">
      <h2 class="max-w-xl text-2xl font-bold text-white">
        Butuh rekomendasi layanan yang sesuai dengan proyek Anda?
      </h2>
      <a
        href={SITE.whatsappUrl}
        class="mt-8 rounded-full bg-accent-500 px-7 py-3 text-sm font-semibold text-white hover:bg-accent-600"
      >
        Konsultasi via WhatsApp
      </a>
    </div>
  </section>
</BaseLayout>
