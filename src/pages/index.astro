---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FaqAccordion from "../components/FaqAccordion";
import { SITE, FAQS } from "../lib/site";
import { IMAGES, PORTFOLIO_ITEMS } from "../lib/images";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
const featuredPortfolio = PORTFOLIO_ITEMS.slice(0, 3);

const whyChooseUs = [
  {
    title: "Presisi di Setiap Detail",
    detail: "Dari persiapan permukaan hingga finishing, setiap tahap dikerjakan dengan standar yang konsisten.",
  },
  {
    title: "Tim Berpengalaman",
    detail: "Ditangani oleh tim yang telah menyelesaikan 150+ proyek untuk klien industri dan pemerintah.",
  },
  {
    title: "Standar Internasional",
    detail: "Layanan pipe wrapping mengikuti standar ISO 21809-1 untuk keandalan perlindungan korosi jangka panjang.",
  },
  {
    title: "Komunikasi Transparan",
    detail: "Update progres dan estimasi biaya disampaikan jelas sejak survey awal hingga serah terima.",
  },
];
---

<BaseLayout title="Beranda">
  <section class="overflow-hidden bg-white">
    <div class="mx-auto grid max-w-[1400px] grid-cols-1 items-center gap-12 px-6 py-[120px] lg:grid-cols-2">
      <div>
        <span class="inline-flex items-center gap-2 rounded-full border border-ink-100 bg-ink-50 px-4 py-1.5 text-sm font-medium text-ink-700">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-white">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
              <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          Dipercaya 25+ Klien Industri &amp; Pemerintah
        </span>

        <h1 class="mt-6 text-4xl font-bold leading-tight text-ink-900 md:text-5xl">
          Permukaan yang Tahan Lama, Bukan Cuma Terlihat Bagus.
        </h1>

        <p class="mt-6 max-w-lg text-lg text-ink-600">
          Dari epoxy flooring hingga pipe wrapping, kami bantu proyek industri dan infrastruktur
          Anda selesai dengan hasil yang presisi, rapi, dan tahan lama.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={SITE.whatsappUrl}
            class="rounded-full bg-brand-600 px-7 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-700"
          >
            Konsultasi Sekarang
          </a>
          <a
            href="/services"
            class="rounded-full border border-ink-200 px-7 py-3 text-sm font-semibold text-ink-800 transition-colors hover:bg-ink-50"
          >
            Lihat Layanan
          </a>
        </div>

        <p class="mt-10 text-sm text-ink-500">
          Tanpa biaya tersembunyi &nbsp;&middot;&nbsp; Respon cepat &nbsp;&middot;&nbsp; Bersertifikasi ISO 21809-1
        </p>
      </div>

      <div class="relative">
        <Image
          src={IMAGES.hero}
          alt="Proyek Munggaran Proteksi"
          class="w-full rounded-3xl object-cover shadow-xl"
          width={900}
          height={700}
        />

        <div class="absolute -bottom-6 left-4 right-4 flex flex-col gap-3 sm:left-8 sm:right-auto sm:w-72">
          <div class="flex items-center gap-3 rounded-2xl border border-ink-100 bg-white p-4 shadow-lg">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-100 text-brand-700">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s7-4.5 7-11V5l-7-3-7 3v6c0 6.5 7 11 7 11z" stroke-linejoin="round" />
                <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-900">Survey Lokasi</p>
              <p class="text-xs text-ink-500">Dijadwalkan dalam 24 jam</p>
            </div>
          </div>
          <div class="flex items-center gap-3 rounded-2xl border border-ink-100 bg-white p-4 shadow-lg">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-accent-400/20 text-accent-600">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round" />
                <rect x="3" y="4" width="18" height="16" rx="2" />
              </svg>
            </span>
            <div>
              <p class="text-sm font-semibold text-ink-900">Penawaran Terkirim</p>
              <p class="text-xs text-ink-500">Tanpa proses berbelit</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-ink-100 bg-white">
    <div class="mx-auto grid max-w-[1400px] grid-cols-1 gap-8 px-6 py-[120px] sm:grid-cols-3">
      {SITE.stats.map((stat) => (
        <div class="text-center">
          <p class="text-4xl font-bold text-brand-600">{stat.value}</p>
          <p class="mt-2 text-sm font-medium text-ink-600">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="layanan-kami" class="scroll-mt-24 mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Layanan Kami</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-900">
        Layanan Surface Finishing untuk Industri &amp; Konstruksi
      </h2>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <a
          href={`/services/${service.id}`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-ink-100 transition-shadow hover:shadow-lg"
        >
          <Image
            src={IMAGES[service.data.cardImage as keyof typeof IMAGES]}
            alt={service.data.title}
            class="h-40 w-full object-cover"
            width={600}
            height={450}
          />
          <div class="flex flex-1 flex-col p-5">
            <h3 class="font-semibold text-ink-900 group-hover:text-brand-600">
              {service.data.title}
            </h3>
            <p class="mt-2 flex-1 text-sm text-ink-600">{service.data.shortDescription}</p>
            <span class="mt-4 text-sm font-semibold text-brand-600">Selengkapnya &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="kenapa-kami" class="scroll-mt-24 bg-ink-50 py-[120px]">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Kenapa Pilih Kami</p>
        <h2 class="mt-3 text-3xl font-bold text-ink-900">Alasan Klien Mempercayakan Proyeknya ke Kami</h2>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {whyChooseUs.map((item) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-6">
            <h3 class="font-semibold text-ink-900">{item.title}</h3>
            <p class="mt-2 text-sm text-ink-600">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="portfolio-preview" class="scroll-mt-24 py-[120px]">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Portfolio</p>
          <h2 class="mt-3 text-3xl font-bold text-ink-900">Sebagian Proyek yang Telah Kami Kerjakan</h2>
        </div>
        <a href="/portfolio" class="text-sm font-semibold text-brand-600 hover:text-brand-700">
          Lihat semua portfolio &rarr;
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-3">
        {featuredPortfolio.map((item) => (
          <div class="overflow-hidden rounded-2xl border border-ink-100 bg-white">
            <Image src={item.image} alt={item.title} class="h-48 w-full object-cover" width={600} height={450} />
            <p class="p-4 text-sm font-medium text-ink-800">{item.title}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="testimoni" class="scroll-mt-24 mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Testimoni</p>
      <h2 class="mt-3 text-3xl font-bold text-ink-900">Apa Kata Klien Kami</h2>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {SITE.testimonials.map((item) => (
        <div class="rounded-2xl border border-ink-100 bg-white p-6">
          <p class="text-ink-700">&ldquo;{item.quote}&rdquo;</p>
          <p class="mt-4 text-sm font-semibold text-ink-900">{item.name}</p>
          <p class="text-sm text-ink-500">{item.company}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="faq" class="scroll-mt-24 bg-ink-50 py-[120px]">
    <div class="mx-auto max-w-3xl px-6">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">FAQ</p>
        <h2 class="mt-3 text-3xl font-bold text-ink-900">Pertanyaan yang Sering Ditanyakan</h2>
      </div>

      <div class="mt-10">
        <FaqAccordion client:visible items={FAQS} />
      </div>
    </div>
  </section>

  <section id="tentang-kami" class="scroll-mt-24 mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 md:items-center">
      <Image src={IMAGES.about} alt="Tim dan workshop Munggaran Proteksi" class="rounded-2xl" width={600} height={450} />
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Tentang Kami</p>
        <h2 class="mt-3 text-3xl font-bold text-ink-900">{SITE.philosophy}</h2>
        <p class="mt-5 text-ink-600">{SITE.description}</p>
        <p class="mt-4 text-ink-600">
          Ditangani tim berpengalaman yang memegang standar kualitas yang sama di setiap proyek —
          dari survey awal, persiapan permukaan, hingga serah terima.
        </p>
        <a href="/about" class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:text-brand-700">
          Selengkapnya tentang kami &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <div class="flex flex-col items-center rounded-3xl bg-brand-700 px-8 py-14 text-center">
      <h2 class="max-w-xl text-2xl font-bold text-white md:text-3xl">
        Punya proyek yang butuh penanganan surface finishing profesional?
      </h2>
      <p class="mt-4 max-w-lg text-brand-100">
        Konsultasikan kebutuhan proyek Anda dengan tim kami — gratis survey dan penawaran.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={SITE.whatsappUrl}
          class="rounded-full bg-accent-500 px-7 py-3 text-sm font-semibold text-white hover:bg-accent-600"
        >
          Chat via WhatsApp
        </a>
        <a
          href="/contact"
          class="rounded-full border border-white/30 px-7 py-3 text-sm font-semibold text-white hover:bg-white/10"
        >
          Hubungi Kami
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
