---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import FaqAccordion from "../components/FaqAccordion";
import ContactForm from "../components/ContactForm";
import TestimonialCarousel from "../components/TestimonialCarousel";
import { SITE, FAQS } from "../lib/site";
import { IMAGES, PORTFOLIO_ITEMS } from "../lib/images";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);
// foto asli proyek: sandblasting/epoxy Riung, pipe wrapping Pertamina di kiri; floor coating Syngenta di kanan
const featuredPortfolio = [PORTFOLIO_ITEMS[1], PORTFOLIO_ITEMS[2], PORTFOLIO_ITEMS[0]];

const certificates = [
  {
    title: "ISO 9001:2015",
    issuer: "Sistem Manajemen Mutu · ACS Indonesia",
    image: "/gallery/sertifikat-iso.jpg",
    href: "/gallery/sertifikat-iso.jpg",
  },
  {
    title: "Penyedia Barang/Jasa Terdaftar",
    issuer: "PT PGAS Solution · Pertamina Gas Negara",
    image: "/gallery/sertifikat-pertamina.jpeg",
    href: "/gallery/sertifikat-pertamina.jpeg",
  },
  {
    title: "Certificate of Registration",
    issuer: "PT Geo Dipa Energi (Persero)",
    image: "/gallery/sertifikat-geodipa.jpg",
    href: "/gallery/sertifikat-geodipa.pdf",
  },
];

const clients = [
  { name: "Argha Karya Prima Industry", logo: "/clients/pln.png" },
  { name: "Inti Persada Teknik", logo: "/clients/ikpt.png" },
  { name: "Tri Mulia Gemilang", logo: "/clients/waskita.png" },
  { name: "Brantas Abipraya", logo: "/clients/abipara.png" },
  { name: "SM Cyclo Indonesia", logo: "/clients/tiki.png" },
  { name: "Antam", logo: "/clients/antam.jpg" },
  { name: "Citra Persana Infrastruktur", logo: "/clients/se.png" },
  { name: "Asahi Diamond Industrial Indonesia", logo: "/clients/kasa.png" },
  { name: "Great Giant Pineapple", logo: "/clients/dole.jpeg" },
  { name: "Samudera Rekso Asri", logo: "/clients/sumitomo.png" },
  { name: "Krakatau Chandra Energi", logo: "/clients/wce.jpeg" },
];

const TARGET_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`;
const HARDHAT_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a6 6 0 0 1 6-6h0"/><path d="M14 6h0a6 6 0 0 1 6 6v3"/></svg>`;
const AWARD_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>`;
const CHAT_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`;

const whyChooseUs = [
  {
    icon: TARGET_ICON,
    title: "Presisi di Setiap Detail",
    detail: "Dari persiapan permukaan hingga finishing, setiap tahap dikerjakan dengan standar yang konsisten.",
  },
  {
    icon: HARDHAT_ICON,
    title: "Tim Berpengalaman",
    detail: "Ditangani oleh tim yang telah menyelesaikan 150+ proyek untuk klien industri dan pemerintah.",
  },
  {
    icon: AWARD_ICON,
    title: "Standar Internasional",
    detail: "Layanan pipe wrapping mengikuti standar ISO 21809-1 untuk keandalan perlindungan korosi jangka panjang.",
  },
  {
    icon: CHAT_ICON,
    title: "Komunikasi Transparan",
    detail: "Update progres dan estimasi biaya disampaikan jelas sejak survey awal hingga serah terima.",
  },
];
---

<BaseLayout title="Beranda">

  {/* ── HERO ── */}
  <section class="relative min-h-[90vh] overflow-hidden bg-[#0d1b4b]">
    {/* Image – visible on right, clipped left by gradient */}
    <Image
      src={IMAGES.hero}
      alt="Proyek Munggaran Proteksi"
      class="absolute inset-0 h-full w-full object-cover object-center"
      width={1600}
      height={900}
    />
    {/* Gradient: solid navy left → transparent ~55% → transparent right */}
    <div class="absolute inset-0 bg-gradient-to-r from-[#0d1b4b] from-40% via-[#0d1b4b]/80 via-55% to-transparent to-75%"></div>

    <div class="relative mx-auto flex max-w-[1400px] flex-col justify-center px-8 pt-28 pb-32 md:pt-36 md:pb-48 lg:min-h-[90vh] lg:max-w-[55%] xl:max-w-[1400px]">
      {/* Badge */}
      <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-[#1a3a7c] px-3 py-1.5 text-xs font-medium text-white/90 sm:gap-2 sm:px-4 sm:py-2 sm:text-sm">
        <svg class="h-3.5 w-3.5 flex-none text-white sm:h-4 sm:w-4" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
        </svg>
        Dipercaya 25+ Klien Industri &amp; Pemerintah
      </span>

      <h1 class="mt-6 max-w-xl text-4xl font-bold leading-tight text-white md:text-5xl lg:text-[3.5rem]">
        Permukaan yang Tahan Lama, Bukan Cuma Terlihat Bagus.
      </h1>

      <p class="mt-6 max-w-lg text-base leading-relaxed text-white/70 md:text-lg">
        Dari epoxy flooring hingga pipe wrapping, kami bantu proyek industri dan infrastruktur
        Anda selesai dengan hasil yang presisi, rapi dan tahan lama.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-accent-400"
        >
          Konsultasi Sekarang
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.076-4.076a1.526 1.526 0 011.037-.443 48.282 48.282 0 005.68-.494c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
        </a>
        <a
          href="#layanan-kami"
          onclick="event.preventDefault();document.getElementById('layanan-kami').scrollIntoView({behavior:'smooth'})"
          class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-transparent px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-white/10"
        >
          Lihat Layanan
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <p class="mt-8 text-sm text-white/40">
        Tanpa biaya tersembunyi &nbsp;·&nbsp; Respon cepat &nbsp;·&nbsp; Bersertifikasi ISO 21809-1
      </p>
    </div>
  </section>

  {/* ── KLIEN KAMI ── */}
  <section class="border-b border-ink-100 bg-white py-28">
    <p class="mb-10 text-center text-sm font-semibold tracking-wide text-ink-400">Klien Kami</p>
    <div class="overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="animate-marquee flex w-max items-center gap-16">
        {[...clients, ...clients].map((client, i) => (
          <img
            src={client.logo}
            alt={client.name}
            class="h-16 w-auto object-contain opacity-60 grayscale transition-all hover:opacity-100 hover:grayscale-0"
          />
        ))}
      </div>
    </div>
  </section>

  {/* ── LAYANAN ── */}
  <section id="layanan-kami" class="scroll-mt-20 bg-white py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold text-ink-900">
            Layanan Surface Finishing untuk<br class="hidden md:block" /> Industri &amp; Konstruksi
          </h2>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((service) => (
          <a
            href={`/services/${service.id}`}
            class="group flex flex-col overflow-hidden rounded-2xl bg-ink-50 transition-all hover:bg-ink-100 hover:shadow-lg"
          >
            <Image
              src={IMAGES[service.data.cardImage as keyof typeof IMAGES]}
              alt={service.data.title}
              class="h-44 w-full object-cover"
              width={600}
              height={450}
            />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-semibold text-ink-900">{service.data.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{service.data.shortDescription}</p>
              <span class="mt-4 text-sm font-semibold text-brand-600 group-hover:text-brand-700">
                Selengkapnya →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── KENAPA KAMI ── */}
  <section id="kenapa-kami" class="scroll-mt-20 bg-navy-800 py-32">
    <div class="mx-auto max-w-[1400px] px-6">
      <h2 class="mt-3 text-3xl font-bold text-white">Alasan Klien Mempercayakan Proyeknya ke Kami</h2>

      <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {whyChooseUs.map((item) => (
          <div class="rounded-2xl border border-white/10 bg-navy-700 p-6">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600/20 text-brand-400">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="mt-4 font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── SERTIFIKASI ── */}
  <section id="sertifikasi" class="scroll-mt-20 bg-white py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-bold tracking-wide text-brand-600">Sertifikasi &amp; Legalitas</p>
        <h2 class="mt-3 text-3xl font-bold text-ink-900">Terdaftar dan Terverifikasi oleh Mitra Industri</h2>
        <p class="mt-3 text-ink-500">Dokumen resmi yang menunjukkan standar mutu dan kualifikasi vendor kami.</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {certificates.map((cert) => (
          <a
            href={cert.href}
            target="_blank"
            rel="noopener noreferrer"
            class="group block overflow-hidden rounded-2xl border border-ink-200 bg-white transition-shadow hover:shadow-lg"
          >
            <div class="aspect-[4/3] overflow-hidden bg-ink-50">
              <img
                src={cert.image}
                alt={`Sertifikat ${cert.title}`}
                class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <h3 class="font-semibold text-ink-900">{cert.title}</h3>
              <p class="mt-1 text-sm text-ink-500">{cert.issuer}</p>
              <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-brand-600">
                Lihat dokumen
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ── PORTFOLIO ── */}
  <section id="portfolio-preview" class="scroll-mt-20 py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">

        {/* kiri: heading + CTA + 2 foto kecil */}
        <div class="flex flex-col">
          <p class="text-sm font-bold tracking-wide text-brand-600">Portofolio</p>
          <h2 class="mt-3 text-4xl font-bold leading-tight text-brand-600">
            Sebagian Proyek yang Telah Kami Kerjakan
          </h2>
          <div class="mt-6">
            <a href="/portfolio" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2 text-sm font-semibold text-white hover:bg-brand-700">
              Lihat Semua Portofolio
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>

          <div class="mt-8 grid grid-cols-2 gap-4 flex-1">
            {featuredPortfolio.slice(0, 2).map((item) => (
              <div class="relative flex flex-col overflow-hidden rounded-2xl bg-ink-100 sm:block">
                <img src={item.image} alt={item.title} class="h-44 w-full object-cover sm:h-56" loading="lazy" />
                <div class="flex-1 bg-ink-900 px-3 py-2.5 sm:absolute sm:bottom-0 sm:left-0 sm:right-0 sm:bg-black/60 sm:px-4 sm:py-3">
                  <p class="text-xs leading-snug text-white sm:text-sm">{item.title}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* kanan: 1 foto besar dengan caption overlay */}
        {featuredPortfolio[2] && (
          <div class="relative overflow-hidden rounded-2xl bg-ink-100 min-h-[480px]">
            <img
              src={featuredPortfolio[2].image}
              alt={featuredPortfolio[2].title}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-6">
              <p class="text-base font-medium text-white">{featuredPortfolio[2].title}</p>
            </div>
          </div>
        )}

      </div>
    </div>
  </section>

  {/* ── TESTIMONI ── */}
  <section id="testimoni" class="scroll-mt-20 bg-white py-24">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="mb-12 text-center">
        <h2 class="text-4xl font-bold text-ink-900">Apa Kata Klien Kami</h2>
        <p class="mt-3 text-ink-500">Klien nyata berbagi pengalaman bekerja sama dengan tim kami.</p>
      </div>
      <TestimonialCarousel client:visible testimonials={SITE.testimonials} />
    </div>
  </section>

  {/* ── TENTANG + STATS ── */}
  <section id="tentang-kami" class="scroll-mt-20 bg-white py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="grid grid-cols-1 items-center gap-12 md:grid-cols-2">
        <Image
          src={IMAGES.about}
          alt="Tim Munggaran Proteksi"
          class="w-full rounded-2xl object-cover shadow-lg"
          width={700}
          height={500}
        />
        <div>
          <h2 class="text-3xl font-bold leading-snug text-ink-900 md:text-4xl">
            Kami adalah perusahaan kontraktor profesional yang bergerak dibidang solusi perawatan permukaan industri.
          </h2>
          <p class="mt-5 text-ink-600">
            Melayani berbagai sektor permukaan industri dengan kualitas dan layanan profesional.
          </p>

          <div class="mt-10 grid grid-cols-3 gap-6 border-t border-ink-100 pt-8">
            {SITE.stats.map((stat) => (
              <div>
                <p class="text-3xl font-bold text-brand-600">{stat.value}</p>
                <p class="mt-1 text-sm text-ink-500">{stat.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── FAQ ── */}
  <section id="faq" class="scroll-mt-20 py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-start">
        <div class="lg:sticky lg:top-28">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">FAQ</p>
          <h2 class="mt-3 text-3xl font-bold text-ink-900">Pertanyaan yang Sering Ditanyakan</h2>
          <p class="mt-4 text-ink-500">
            Belum menemukan jawaban yang kamu cari?{" "}
            <a href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-600 hover:underline">
              Hubungi kami langsung.
            </a>
          </p>
        </div>
        <div>
          <FaqAccordion client:visible items={FAQS} />
        </div>
      </div>
    </div>
  </section>

  {/* ── KONTAK INLINE ── */}
  <section id="kontak" class="scroll-mt-20 bg-white py-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-stretch">
        {/* Form */}
        <div class="flex h-full flex-col rounded-2xl bg-ink-50 p-8">
          <h2 class="text-2xl font-bold text-ink-900">Kirim Pesan ke Kami</h2>
          <p class="mt-2 text-sm text-ink-500">Isi form di bawah, tim kami akan merespons dalam 24 jam.</p>
          <div class="mt-6">
            <ContactForm client:visible accessKey="GANTI_DENGAN_WEB3FORMS_ACCESS_KEY" />
          </div>
          <div class="mt-4">
            <a
              href={SITE.whatsappUrl} target="_blank" rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 rounded-full border border-ink-200 bg-white py-3 text-sm font-semibold text-ink-700 transition-colors hover:bg-ink-100"
            >
              Chat Langsung via WhatsApp
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </div>
        </div>

        {/* Info + Map */}
        <div class="flex flex-col gap-6">
          <div>
            <p class="text-sm font-semibold tracking-wide text-ink-400">Email</p>
            <a href={`mailto:${SITE.email}`} class="mt-1 text-ink-900 hover:text-brand-600">{SITE.email}</a>
          </div>
          <div>
            <p class="text-sm font-semibold tracking-wide text-ink-400">Kantor</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">{SITE.officeAddress}</p>
          </div>
          <div>
            <p class="text-sm font-semibold tracking-wide text-ink-400">Workshop</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600">{SITE.workshopAddress}</p>
          </div>

          {/* Google Maps embed — kantor */}
          <div class="overflow-hidden rounded-2xl border border-ink-200">
            <iframe
              title="Lokasi Kantor Munggaran Proteksi"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3965.5!2d106.98!3d-6.28!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMTYnNDguMCJTIDEwNsKwNTgnNDguMCJF!5e0!3m2!1sen!2sid!4v1234567890"
              width="100%"
              height="360"
              style="border:0;display:block"
              allowfullscreen
              loading="lazy"
