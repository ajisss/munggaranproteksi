---
import BaseLayout from "../layouts/BaseLayout.astro";
import Gallery from "../components/Gallery";
import { PORTFOLIO_ITEMS, CATEGORY_LABELS } from "../lib/images";

const galleryItems = PORTFOLIO_ITEMS.map((item) => ({
  title: item.title,
  category: item.category,
  categoryLabel: CATEGORY_LABELS[item.category],
  src: item.image,
}));
---

<BaseLayout title="Portfolio" description="Portfolio proyek Munggaran Proteksi: epoxy flooring, sandblasting & painting, polished concrete, dan pipe wrapping.">
  <section class="bg-ink-900 py-[120px] text-white">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Portfolio</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold leading-tight">
        Proyek yang Telah Kami Kerjakan
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">
        150+ proyek untuk klien industri, komersial, dan pemerintah.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-6 py-[120px]">
    <Gallery client:load items={galleryItems} />
  </section>
</BaseLayout>
